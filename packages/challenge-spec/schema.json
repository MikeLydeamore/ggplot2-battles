{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ap.ggplotbattles.dev/schema/challenge-spec-v1.json",
  "title": "ggplot Battles ChallengeSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatorVersion", "trialId", "seed", "technique", "dataset", "plot", "requiredItems", "predicates", "thresholds", "brief"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "const": 2 },
    "trialId": { "type": ["integer", "string"] },
    "seed": { "type": "integer", "minimum": 1 },
    "technique": { "enum": ["Points", "Distributions", "Categorical", "Lines", "Intervals"] },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "rows", "groups", "slope", "trend", "seasonality", "grouped"],
      "properties": {
        "kind": { "enum": ["correlated", "distributions", "categorical", "timeseries", "intervals"] },
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._]*$" },
        "rows": { "type": "integer", "minimum": 8, "maximum": 84 },
        "groups": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "slope": { "type": "number" },
        "trend": { "type": "number" },
        "seasonality": { "type": "number" },
        "grouped": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["categorical", "intervals"] } } },
          "then": { "properties": { "rows": { "minimum": 8, "maximum": 12 } } },
          "else": { "properties": { "rows": { "minimum": 48, "maximum": 84 } } }
        }
      ]
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping", "layers", "facet", "facetParams", "scale", "coordinate", "annotation", "theme", "themeParams", "palette", "title", "xLabel", "yLabel"],
      "properties": {
        "mapping": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["x", "y", "colour", "fill", "group"] },
          "additionalProperties": { "enum": ["x", "y", "group", "value", "category", "time", "lower", "upper", "label", "estimate"] }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/layer" }
        },
        "facet": { "type": ["string", "null"], "enum": ["group", null] },
        "facetParams": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ncol": { "enum": [1, 2, 3] },
            "scales": { "enum": ["fixed", "free_y"] }
          }
        },
        "scale": { "enum": ["log10", "reverse", null] },
        "coordinate": { "enum": ["flip", "polar", null] },
        "annotation": { "type": ["string", "null"] },
        "theme": { "enum": ["theme_minimal", "theme_bw", "theme_classic"] },
        "themeParams": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseSize"],
          "properties": { "baseSize": { "enum": [10, 11, 12, 13] } }
        },
        "palette": {
          "enum": [
            ["#0dcaf0", "#ff6b6b", "#ffd166"],
            ["#20c997", "#845ef7", "#ff922b"],
            ["#3a86ff", "#ff006e", "#ffbe0b"],
            ["#2a9d8f", "#e76f51", "#e9c46a"]
          ]
        },
        "title": { "type": "string" },
        "xLabel": { "type": "string" },
        "yLabel": { "type": "string" }
      }
    },
    "requiredItems": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match", "value", "minimum"],
        "properties": {
          "match": { "enum": ["contains", "exact", "regex"] },
          "value": { "type": "string", "minLength": 1 },
          "minimum": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "mastery"],
      "properties": {
        "match": { "type": "number", "minimum": 0, "maximum": 100 },
        "mastery": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "schema", "colours"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "schema": { "type": "string" },
        "colours": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
      }
    }
  },
  "$defs": {
    "layer": {
      "oneOf": [
        { "$ref": "#/$defs/pointLayer" },
        { "$ref": "#/$defs/smoothLayer" },
        { "$ref": "#/$defs/histogramLayer" },
        { "$ref": "#/$defs/densityLayer" },
        { "$ref": "#/$defs/colLayer" },
        { "$ref": "#/$defs/lineLayer" },
        { "$ref": "#/$defs/ribbonLayer" },
        { "$ref": "#/$defs/errorbarLayer" },
        { "$ref": "#/$defs/linerangeLayer" }
      ]
    },
    "pointLayer": {
      "type": "object", "additionalProperties": false, "required": ["geom", "params"],
      "properties": { "geom": { "const": "point" }, "params": { "$ref": "#/$defs/pointParams" } }
    },
    "pointParams": {
      "type": "object", "additionalProperties": false, "required": ["size", "alpha", "shape"],
      "properties": { "size": { "enum": [1.6, 2.1, 2.7, 3.2] }, "alpha": { "enum": [0.65, 0.8, 1.0] }, "shape": { "enum": [16, 17, 19] } }
    },
    "smoothLayer": {
      "type": "object", "additionalProperties": false, "required": ["geom", "params"],
      "properties": { "geom": { "const": "smooth" }, "params": { "$ref": "#/$defs/smoothParams" } }
    },
    "smoothParams": {
      "type": "object", "additionalProperties": false, "required": ["method", "se", "linewidth"],
      "properties": { "method": { "enum": ["lm", "loess"] }, "se": { "type": "boolean" }, "linewidth": { "enum": [0.6, 0.8, 1.0] } }
    },
    "histogramLayer": {
      "type": "object", "additionalProperties": false, "required": ["geom", "params"],
      "properties": { "geom": { "const": "histogram" }, "params": { "$ref": "#/$defs/histogramParams" } }
    },
    "histogramParams": {
      "type": "object", "additionalProperties": false, "required": ["bins", "alpha", "boundary"],
      "properties": { "bins": { "enum": [12, 18, 24, 30] }, "alpha": { "enum": [0.58, 0.74, 0.9] }, "boundary": { "enum": [0.0, 0.25, 0.5] } }
    },
    "densityLayer": {
      "type": "object", "additionalProperties": false, "required": ["geom", "params"],
      "properties": { "geom": { "const": "density" }, "params": { "$ref": "#/$defs/densityParams" } }
    },
    "densityParams": {
      "type": "object", "additionalProperties": false, "required": ["adjust", "alpha", "linewidth"],
      "properties": { "adjust": { "enum": [0.7, 1.0, 1.3] }, "alpha": { "enum": [0.25, 0.4, 0.55] }, "linewidth": { "enum": [0.6, 0.8, 1.0] } }
    },
    "colLayer": {
      "type": "object", "additionalProperties": false, "required": ["geom", "params"],
      "properties": { "geom": { "const": "col" }, "params": { "$ref": "#/$defs/colParams" } }
    },
    "colParams": {
      "type": "object", "additionalProperties": false, "required": ["width", "alpha"],
      "properties": { "width": { "enum": [0.58, 0.72, 0.86] }, "alpha": { "enum": [0.7, 0.85, 1.0] } }
    },
    "lineLayer": {
      "type": "object", "additionalProperties": false, "required": ["geom", "params"],
      "properties": { "geom": { "const": "line" }, "params": { "$ref": "#/$defs/lineParams" } }
    },
    "lineParams": {
      "type": "object", "additionalProperties": false, "required": ["linewidth", "linetype"],
      "properties": { "linewidth": { "enum": [0.6, 0.85, 1.1] }, "linetype": { "enum": ["solid", "dashed", "dotdash"] } }
    },
    "ribbonLayer": {
      "type": "object", "additionalProperties": false, "required": ["geom", "params"],
      "properties": { "geom": { "const": "ribbon" }, "params": { "$ref": "#/$defs/ribbonParams" } }
    },
    "ribbonParams": {
      "type": "object", "additionalProperties": false, "required": ["alpha"],
      "properties": { "alpha": { "enum": [0.12, 0.2, 0.3] } }
    },
    "errorbarLayer": {
      "type": "object", "additionalProperties": false, "required": ["geom", "params"],
      "properties": { "geom": { "const": "errorbar" }, "params": { "$ref": "#/$defs/errorbarParams" } }
    },
    "errorbarParams": {
      "type": "object", "additionalProperties": false, "required": ["width", "linewidth"],
      "properties": { "width": { "enum": [0.1, 0.18, 0.28] }, "linewidth": { "enum": [0.5, 0.7, 0.9] } }
    },
    "linerangeLayer": {
      "type": "object", "additionalProperties": false, "required": ["geom", "params"],
      "properties": { "geom": { "const": "linerange" }, "params": { "$ref": "#/$defs/linerangeParams" } }
    },
    "linerangeParams": {
      "type": "object", "additionalProperties": false, "required": ["linewidth"],
      "properties": { "linewidth": { "enum": [0.6, 0.85, 1.1] } }
    }
  }
}
