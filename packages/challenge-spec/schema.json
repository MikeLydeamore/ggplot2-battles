{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ap.ggplotbattles.dev/schema/challenge-spec-v1.json",
  "title": "ggplot Battles ChallengeSpec",
  "type": "object",
  "required": ["schemaVersion", "generatorVersion", "trialId", "seed", "technique", "dataset", "plot", "requiredItems", "predicates", "thresholds", "brief"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "const": 2 },
    "trialId": { "type": ["integer", "string"] },
    "seed": { "type": "integer", "minimum": 1 },
    "technique": { "enum": ["Points", "Distributions", "Categorical", "Lines", "Intervals", "Composition"] },
    "dataset": { "type": "object", "required": ["kind", "rows", "name"] },
    "plot": {
      "type": "object",
      "required": ["layers", "theme", "palette"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["geom", "params"],
            "properties": {
              "geom": { "enum": ["point", "smooth", "histogram", "density", "col", "line", "ribbon", "errorbar", "linerange"] },
              "params": { "type": "object" }
            }
          }
        },
        "facetParams": { "type": "object" },
        "themeParams": { "type": "object" }
      }
    },
    "requiredItems": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "predicates": { "type": "array", "minItems": 1 },
    "thresholds": {
      "type": "object",
      "required": ["match", "mastery"],
      "properties": {
        "match": { "type": "number", "minimum": 0, "maximum": 100 },
        "mastery": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "brief": { "type": "object", "required": ["title", "description", "schema", "colours"] }
  }
}
